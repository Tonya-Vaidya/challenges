#taking out one letter randomly at a time and placing back in randomly

import random  

string = "The Ship of Theseus"
print(string)
string = list(string)

while string:
    # Randomly select a letter to remove
    random_index = random.randint(0, len(string) - 1)
    removed_letter = string.pop(random_index)
    print(f"{''.join(string)}")

original_string = "The Ship of Theseus"
letters_with_positions = list(enumerate(original_string))
random.shuffle(letters_with_positions)  # Shuffle the list randomly

# Remove letters randomly and print the removal process
removed_letters = []
for position, letter in letters_with_positions:
    removed_letters.append((position, letter))
    print(f"{''.join([l for _, l in sorted(removed_letters[:-1])])}")

# Add letters back to their original positions
restored_string = [''] * len(original_string)  # Create a placeholder list
for position, letter in sorted(removed_letters):  # Sort by original positions
    restored_string[position] = letter
    print(f"{join(restored_string)}")
    
string = "The Ship of Theseus"
print(string)

