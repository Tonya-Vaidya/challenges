# A continuous loop of removing and replacing letters.

import time

string = "The Ship of Theseus"
print(string)

characters = list(string)

while True: 
    for i in range(len(characters)):
        removed_char = characters[i]
        characters[i] = ''  
        print(''.join(characters))  
        characters[i] = removed_char
        print(''.join(characters))  


